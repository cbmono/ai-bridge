{
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome__*"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -fr /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(terraform destroy:*)",
      "Bash(tofu destroy:*)"
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-state.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-banner.sh --format json"
          }
        ]
      }
    ]
  }
}

#!/usr/bin/env bash
#
# ai-bridge-claude — start `claude` in this bundle on the account the bundle declares.
#
#   Usage: ai-bridge-claude [--print-env] [--bundle DIR] [claude args...]
#
#   exit 2 usage · 3 no bundle / no `account:` declared · 4 that account is not logged in
#        · 5 refused: the account's config dir is inside a repo
#
# It sets two env vars and execs. It never reads, writes, copies or prints a credential,
# and nothing it does can write into the bundle. See companion/accounts.md.
set -uo pipefail

print_env=0
bundle=""
while [ $# -gt 0 ]; do
  case "$1" in
    --print-env) print_env=1; shift ;;
    --bundle)
      [ $# -ge 2 ] || { echo "ai-bridge-claude: --bundle needs a directory" >&2; exit 2; }
      bundle="$2"; shift 2 ;;
    -h|--help) sed -n '3,11p' "$0"; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

# The bundle root: this directory or the nearest ancestor carrying both markers.
if [ -z "$bundle" ]; then
  d="$PWD"
  while [ -n "$d" ]; do
    if [ -f "$d/instance.config.json" ] && [ -f "$d/SCHEMA.md" ]; then bundle="$d"; break; fi
    [ "$d" = "/" ] && break
    d="$(dirname "$d")"
  done
fi
[ -n "$bundle" ] && [ -f "$bundle/instance.config.json" ] || {
  echo "ai-bridge-claude: not in an ai-bridge bundle (no instance.config.json)" >&2; exit 3; }
bundle="$(cd "$bundle" && pwd)"

label=""
for f in "$bundle/instance.config.local.json" "$bundle/instance.config.json"; do
  [ -f "$f" ] || continue
  label="$(sed -n 's/.*"account"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n 1)"
  [ -n "$label" ] && break
done
case "$label" in
  ""|*[!A-Za-z0-9._-]*)
    echo "ai-bridge-claude: $bundle declares no usable \"account\" — add one to instance.config.json" >&2
    exit 3 ;;
esac
[ "${#label}" -le 32 ] || { echo "ai-bridge-claude: account label is too long" >&2; exit 3; }

accounts_home="${AI_BRIDGE_ACCOUNTS_HOME:-${HOME:-}/.claude-accounts}"
dir="$accounts_home/$label"
mkdir -p "$dir" 2>/dev/null || { echo "ai-bridge-claude: cannot create $dir" >&2; exit 5; }
dir="$(cd "$dir" && pwd)"

# CRITERION 4, STRUCTURALLY. A config dir inside the bundle would put whatever Claude Code
# stores there into a git repo, so it is refused rather than documented against.
case "$dir/" in "$bundle"/*) echo "ai-bridge-claude: refusing — $dir is inside the bundle" >&2; exit 5 ;; esac
if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "ai-bridge-claude: refusing — $dir is inside a git work tree" >&2; exit 5
fi

if [ "$print_env" -eq 1 ]; then
  printf 'CLAUDE_CONFIG_DIR=%s\nAI_BRIDGE_ACCOUNT=%s\n' "$dir" "$label"
  exit 0
fi

# Never a silent session on the wrong plan: refuse before exec, and say which org.
status="$(CLAUDE_CONFIG_DIR="$dir" claude auth status --json 2>/dev/null)" || status=""
case "$status" in
  *'"loggedIn": true'*|*'"loggedIn":true'*) ;;
  *)
    echo "ai-bridge-claude: account '$label' is not logged in. One-time setup:" >&2
    printf '    CLAUDE_CONFIG_DIR=%q claude auth login\n' "$dir" >&2
    printf '    CLAUDE_CONFIG_DIR=%q claude plugin marketplace add cbmono/ai-bridge\n' "$dir" >&2
    printf '    CLAUDE_CONFIG_DIR=%q claude plugin install -y ai-bridge@ai-bridge\n' "$dir" >&2
    exit 4 ;;
esac
# orgName only — never the email the same payload carries.
org="$(printf '%s' "$status" | sed -n 's/.*"orgName"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
printf 'ai-bridge: account %s%s\n' "$label" "${org:+ · $org}" >&2

export CLAUDE_CONFIG_DIR="$dir" AI_BRIDGE_ACCOUNT="$label"
exec claude "$@"
